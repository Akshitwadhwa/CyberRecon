# Copy to .env in this folder. Never commit the real .env file.
OPENAI_API_KEY=your_openai_api_key_here
# Optional local model later:
# OPENAI_API_BASE=http://localhost:11434/v1
# LLM_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini
# Optional bearer token for the read-only dashboard API.
CYBERRECON_API_TOKEN=replace_with_dashboard_token
# Optional bearer token shared only by the ADK worker and CrewAI A2A service.
CYBERRECON_A2A_TOKEN=replace_with_internal_a2a_token
# Comma-separated exact browser origins allowed by the dashboard API.
CYBERRECON_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
